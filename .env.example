# Discord Bot トークン(シークレット)
DISCORD_TOKEN=your-bot-token

# DB 認証情報
DB_USER=postgres
DB_PASSWORD=password

# カテゴリ内チャンネル数の警告閾値(既定 45)
CHANNEL_WARN_THRESHOLD=45

# 開発用ギルド ID(任意)。設定するとグローバル登録ではなくこのギルドに
# コマンドを登録し、即時反映される(開発時のコマンド反映待ちを回避)
# DEVELOPMENT_GUILD_ID=123456789012345678

# --- Web コンソール(Web仕様書.md) ---

# Discord Developer Portal の OAuth2 クライアント認証情報
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret

# Web コンソールの公開 URL。{PUBLIC_BASE_URL}/oauth/callback を
# Discord Developer Portal の Redirects に登録すること
# Cloudflare Tunnel(Named Tunnel)経由で公開する場合は、Tunnel の
# Public Hostname に設定したホスト名に合わせること(例: https://sakenomi.your-domain.com)
PUBLIC_BASE_URL=http://localhost:8080

# --- Cloudflare Tunnel ---
# Cloudflare Zero Trust ダッシュボード(Networks > Tunnels)で作成した
# Tunnel の Token。docker-compose の cloudflared サービスが使用する。
# Public Hostname 設定では Service を http://bot:8080 に向けること
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# セッション Cookie の暗号化キー(hex 32桁 = 16byte)・署名キー(hex, 任意長)
# 本番運用では必ず固有のランダム値に差し替えること
# 生成例(PowerShell): -join ((1..32) | ForEach-Object { "{0:x2}" -f (Get-Random -Max 256) })
SESSION_ENCRYPT_KEY=0123456789abcdef0123456789abcdef
SESSION_SIGN_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Web コンソールのポート(既定 8080)
WEB_PORT=8080